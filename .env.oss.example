# MLPal Assistants Gateway — self-hosted (OSS). Copy to `.env`, set >=1 key.
# The docker-compose stack sets DB/Redis + local-mode flags for you; you only
# need to provide the provider keys you have. Adapters light up per key present.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional: enable Bedrock (needs AWS creds in the environment).
# MLPAL_ENABLE_BEDROCK=true
